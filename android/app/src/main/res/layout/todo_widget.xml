<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="ToDo"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/widget_add_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@null"
            android:src="@drawable/ic_widget_add"
            android:contentDescription="Add task"/>

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginBottom="4dp"/>

    <TextView android:id="@+id/widget_task_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DDDDDD" android:textSize="13sp" android:paddingTop="4dp" android:paddingBottom="4dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
    <TextView android:id="@+id/widget_task_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DDDDDD" android:textSize="13sp" android:paddingTop="4dp" android:paddingBottom="4dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
    <TextView android:id="@+id/widget_task_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DDDDDD" android:textSize="13sp" android:paddingTop="4dp" android:paddingBottom="4dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
    <TextView android:id="@+id/widget_task_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DDDDDD" android:textSize="13sp" android:paddingTop="4dp" android:paddingBottom="4dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
    <TextView android:id="@+id/widget_task_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DDDDDD" android:textSize="13sp" android:paddingTop="4dp" android:paddingBottom="4dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
    <TextView android:id="@+id/widget_task_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DDDDDD" android:textSize="13sp" android:paddingTop="4dp" android:paddingBottom="4dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
    <TextView android:id="@+id/widget_task_6" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DDDDDD" android:textSize="13sp" android:paddingTop="4dp" android:paddingBottom="4dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
    <TextView android:id="@+id/widget_task_7" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DDDDDD" android:textSize="13sp" android:paddingTop="4dp" android:paddingBottom="4dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>

    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="No tasks"
        android:textColor="#88FFFFFF"
        android:gravity="center"
        android:textSize="13sp"
        android:visibility="gone"/>

</LinearLayout>
